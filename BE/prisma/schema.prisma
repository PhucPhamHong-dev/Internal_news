generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR_MANAGER
  WRITER
  VIEWER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  ADMIN_BROADCAST
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED
}

enum ReactionType {
  LIKE
  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

model EmployeeMaster {
  id                       String   @id @default(cuid())
  msnv                     String   @unique
  fullName                 String
  loginEmail               String?  @unique
  isActive                 Boolean  @default(true)
  preferredRole            Role     @default(VIEWER)
  canPost                  Boolean  @default(false)
  canManageEmployees       Boolean  @default(false)
  passwordHash             String?
  temporaryPasswordPreview String?
  mustChangePassword       Boolean  @default(false)
  activatedAt              DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime @default(now())
  linkedUser               User?

  @@index([isActive, msnv])
  @@index([preferredRole, createdAt])
}

model User {
  id            String              @id @default(cuid())
  email         String?             @unique
  googleSub     String?             @unique
  fullName      String
  avatarUrl     String?
  role          Role                @default(VIEWER)
  canPost       Boolean             @default(false)
  canManageEmployees Boolean        @default(false)
  employeeId    String?             @unique
  employee      EmployeeMaster?     @relation(fields: [employeeId], references: [id])
  posts         Post[]
  comments      Comment[]
  postLikes     PostLike[]
  postViews     PostView[]
  commentLikes  CommentLike[]
  notifications Notification[]
  reads         NotificationRead[]
  anonIdentites AnonymousIdentity[]
  themeKey      String              @default("blue")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  title       String
  content     String
  contentBlocks Json?
  media       PostMedia[]
  likes       PostLike[]
  views       PostView[]
  comments    Comment[]
  anonymousIdentities AnonymousIdentity[]
  pinnedAt    DateTime?
  pinPriority Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt, id])
  @@index([pinPriority, pinnedAt, createdAt])
  @@index([authorId, createdAt])
}

model PostMedia {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type     MediaType
  url      String
  thumbnailUrl String?
  publicId String
  thumbnailPublicId String?
  sortOrder Int @default(0)
  caption String?
  clientBlockId String?
  createdAt DateTime @default(now())

  @@index([postId, sortOrder])
  @@index([postId, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  reactionType ReactionType @default(LIKE)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model NicknamePool {
  id                 String              @id @default(cuid())
  label              String              @unique
  anonymousIdentites AnonymousIdentity[]
  createdAt          DateTime            @default(now())
}

model AnonymousIdentity {
  id          String   @id @default(cuid())
  postId      String
  userId      String
  nicknameId  String
  nickname    NicknamePool @relation(fields: [nicknameId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, parentId, createdAt])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Notification {
  id         String            @id @default(cuid())
  recipientId String
  recipient  User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type       NotificationType
  message    String
  metadata   Json?
  reads      NotificationRead[]
  createdAt  DateTime          @default(now())

  @@index([recipientId, createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}
